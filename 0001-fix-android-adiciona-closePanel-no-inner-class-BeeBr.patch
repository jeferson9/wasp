From 294367ab0b94e424ff528513af6624c81795682f Mon Sep 17 00:00:00 2001
From: Wasp Dev <wasp@dev.com>
Date: Mon, 22 Jun 2026 11:32:38 +0000
Subject: [PATCH] fix(android): adiciona closePanel() no inner class BeeBridge
 do BeeActivity

O AndroidBee registrado na WebView usa o inner class BeeBridge do BeeActivity,
nao o BeeBridge.kt separado. closePanel() foi adicionado no lugar errado antes.
Correcao: closePanel() agora esta no inner class, chama finish() via mainHandler.
---
 app/src/main/java/com/waspbrowser/app/BeeActivity.kt | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/app/src/main/java/com/waspbrowser/app/BeeActivity.kt b/app/src/main/java/com/waspbrowser/app/BeeActivity.kt
index 68d498d..9440211 100644
--- a/app/src/main/java/com/waspbrowser/app/BeeActivity.kt
+++ b/app/src/main/java/com/waspbrowser/app/BeeActivity.kt
@@ -767,6 +767,11 @@ class BeeActivity : AppCompatActivity() {
             val wallet = prefs.getString(BeeBackgroundService.KEY_WALLET, "") ?: ""
             return """{"active":$active,"remainingMs":$remaining,"cycles":$cycles,"wallet":"$wallet"}"""
         }
+
+        @JavascriptInterface
+        fun closePanel() {
+            mainHandler.post { finish() }
+        }
     }
 
 
