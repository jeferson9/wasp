From bd8f6c68dc75869878ac6c9396764d5f69783b16 Mon Sep 17 00:00:00 2001
From: Wasp Dev <wasp@dev.com>
Date: Mon, 22 Jun 2026 11:24:32 +0000
Subject: [PATCH] fix(ux): move botao X de fechar para o header fixo do painel
 Bee Engine

- Remove botao X que ficava no meio do conteudo (abaixo do bloco Central WP)
- Adiciona botao X no header fixo (bee-header), alinhado a direita apos o epoch label
- Estilo identico ao da Central WP: 36px, border-radius:12px, fundo sutil, cor muted
- Animacao de toque via ontouchstart/ontouchend (scale .88)
- Chama AndroidBee.closePanel() com fallback para history.back()
- closePanel() no BeeBridge ja faz finish() na BeeActivity via main thread handler
---
 app/src/main/assets/bee/index.html | 9 +++------
 1 file changed, 3 insertions(+), 6 deletions(-)

diff --git a/app/src/main/assets/bee/index.html b/app/src/main/assets/bee/index.html
index aa7d734..83354ec 100644
--- a/app/src/main/assets/bee/index.html
+++ b/app/src/main/assets/bee/index.html
@@ -374,6 +374,9 @@
 
     <!-- Epoch -->
     <div id="hdr-epoch-label" style="font-size:10px;color:#ffc107;font-weight:700;letter-spacing:0.5px;flex-shrink:0;opacity:0.7;"></div>
+
+    <!-- Botão fechar -->
+    <button onclick="try{if(window.AndroidBee&&typeof AndroidBee.closePanel==='function'){AndroidBee.closePanel()}else{history.back()}}catch(_){history.back()}" style="width:36px;height:36px;border-radius:12px;background:rgba(255,255,255,0.07);border:1px solid rgba(200,208,224,0.18);color:#c8d0e0;font-size:17px;display:flex;align-items:center;justify-content:center;flex-shrink:0;cursor:pointer;transition:transform .15s ease;" ontouchstart="this.style.transform='scale(.88)'" ontouchend="this.style.transform='scale(1)'">✕</button>
 </div>
 
 <!-- ── BOTÃO CENTRAL WP ── -->
@@ -419,12 +422,6 @@
     </div>
 </div>
 
-<!-- Botão fechar painel -->
-<button id="btnClosePanel" onclick="if(window.AndroidBee&&AndroidBee.closePanel){AndroidBee.closePanel()}else{window.AndroidBee&&AndroidBee.finish?AndroidBee.finish():history.back()}" style="display:flex;align-items:center;justify-content:center;gap:6px;width:100%;margin-top:4px;padding:10px 0;background:transparent;border:1px solid rgba(200,208,224,0.18);border-radius:10px;color:var(--muted);font-size:13px;cursor:pointer;">
-    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg"><line x1="1" y1="1" x2="13" y2="13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><line x1="13" y1="1" x2="1" y2="13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
-    <span data-i18n="btn_close_panel">Close</span>
-</button>
-
 <div class="switch-row">
     <div>
         <div style="font-weight:700;font-size:15px;" data-i18n="mining_title">Mining</div>
-- 
