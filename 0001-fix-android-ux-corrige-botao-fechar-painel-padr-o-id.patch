+    // ── Fecha o painel Bee Engine — mesmo padrão do closeCentral() ──
+    function closeBeePanel() {
+        try {
+            if (window.AndroidBee && typeof window.AndroidBee.closePanel === "function") {
+                window.AndroidBee.closePanel();
+                return;
+            }
+            if (window.Android && typeof window.Android.closePanel === "function") {
+                window.Android.closePanel();
+                return;
+            }
+            if (history.length > 1) history.back();
+            else window.close();
+        } catch(_) { history.back(); }
+    }
+
