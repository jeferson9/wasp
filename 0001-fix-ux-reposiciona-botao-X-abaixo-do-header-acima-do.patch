From 5d1c3ce6bcaf344fdf15907957cf038cece8e643 Mon Sep 17 00:00:00 2001
From: Wasp Dev <wasp@dev.com>
Date: Mon, 22 Jun 2026 11:37:06 +0000
Subject: [PATCH] =?UTF-8?q?fix(ux):=20reposiciona=20botao=20X=20=E2=80=94?=
 =?UTF-8?q?=20abaixo=20do=20header,=20acima=20do=20Central=20WP?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Remove X do header fixo (onde ficava junto com wallet/barra/epoch).
Coloca como primeiro elemento do conteudo scrollavel, entre o header
e o botao Central WP. Estilo discreto com feedback visual no toque.
---
 app/src/main/assets/bee/index.html | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/app/src/main/assets/bee/index.html b/app/src/main/assets/bee/index.html
index 40b5664..9128e16 100644
--- a/app/src/main/assets/bee/index.html
+++ b/app/src/main/assets/bee/index.html
@@ -374,11 +374,14 @@
 
     <!-- Epoch -->
     <div id="hdr-epoch-label" style="font-size:10px;color:#ffc107;font-weight:700;letter-spacing:0.5px;flex-shrink:0;opacity:0.7;"></div>
-
-    <!-- Botão fechar painel -->
-    <button onclick="try{if(window.AndroidBee&&typeof AndroidBee.closePanel==='function'){AndroidBee.closePanel()}else{history.back()}}catch(_){history.back()}" style="width:36px;height:36px;border-radius:12px;background:rgba(255,255,255,0.07);border:1px solid rgba(200,208,224,0.18);color:#c8d0e0;font-size:18px;display:flex;align-items:center;justify-content:center;flex-shrink:0;cursor:pointer;transition:transform .15s ease;" ontouchstart="this.style.transform='scale(.88)'" ontouchend="this.style.transform='scale(1)'">✕</button>
 </div>
 
+<!-- ── BOTÃO FECHAR PAINEL ── -->
+<button onclick="try{if(window.AndroidBee&&typeof AndroidBee.closePanel==='function'){AndroidBee.closePanel()}else{history.back()}}catch(_){history.back()}" style="display:flex;align-items:center;justify-content:center;gap:8px;width:100%;padding:11px 0;margin-bottom:4px;background:rgba(255,255,255,0.05);border:1px solid rgba(200,208,224,0.15);border-radius:14px;color:#c8d0e0;font-size:14px;cursor:pointer;" ontouchstart="this.style.opacity='.6'" ontouchend="this.style.opacity='1'">
+    <span style="font-size:16px;line-height:1;">✕</span>
+    <span data-i18n="btn_close_panel">Close</span>
+</button>
+
 <!-- ── BOTÃO CENTRAL WP ── -->
 <button class="central-wp-btn" onclick="openCentralWP()">
     <div class="cwb-left">
-- 
