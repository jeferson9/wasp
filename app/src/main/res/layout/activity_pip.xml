<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080A0F">

    <!-- Grid lines tech background -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_gravity="center_vertical"
        android:alpha="0.06"
        android:background="#00E5FF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <!-- Ícone + pulse -->
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp">

            <View
                android:id="@+id/pipPulse"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:background="@drawable/pip_pulse_bg" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="🐝"
                android:textSize="20sp" />
        </FrameLayout>

        <!-- Info central -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/pipDot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/pip_dot_green"
                    android:layout_marginEnd="5dp" />

                <TextView
                    android:id="@+id/pipStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MINING"
                    android:textColor="#00E5FF"
                    android:textSize="9sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.15" />
            </LinearLayout>

            <TextView
                android:id="@+id/pipEpoch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACKI NACKI"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <!-- Barra de progresso -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="4dp"
                android:background="#1A2030">

                <View
                    android:id="@+id/pipProgress"
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:background="#00E5FF" />
            </FrameLayout>
        </LinearLayout>

        <!-- Contador -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/pipTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#FFC107"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EPOCH"
                android:textColor="#4A5568"
                android:textSize="7sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.1" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
