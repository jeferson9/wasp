<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#111420">

    <!-- Toolbar: começa GONE, só aparece ao navegar -->
    <include
        android:id="@+id/topBar"
        layout="@layout/toolbar_wasp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:visibility="gone" />

    <!-- Bee Panel: começa GONE (height=0). Quando mineração ativa aparece no rodapé (120dp).
         Quando expandido ocupa a tela toda (MATCH_PARENT). -->
    <FrameLayout
        android:id="@+id/bee_panel_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_alignParentBottom="true"
        android:background="#0B0B0D"
        android:visibility="gone" />

    <!-- Conteúdo principal: browser + home -->
    <FrameLayout
        android:id="@+id/main_content_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBar"
        android:layout_above="@id/bee_panel_container">

        <WebView
            android:id="@+id/webAppView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#111420" />

        <org.mozilla.geckoview.GeckoView
            android:id="@+id/geckoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#111420"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/pageProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100"
            android:progressTint="@color/wasp_yellow"
            android:progressBackgroundTint="#22000000"
            android:visibility="gone" />

    </FrameLayout>

</RelativeLayout>
