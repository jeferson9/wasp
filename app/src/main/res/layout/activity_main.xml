<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="#111420">

    <!-- Toolbar -->
    <include
        android:id="@+id/topBar"
        layout="@layout/toolbar_wasp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <!-- Conteúdo principal (home + browser) — ocupa o espaço restante -->
    <FrameLayout
        android:id="@+id/main_content_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/webAppView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#111420" />

        <org.mozilla.geckoview.GeckoView
            android:id="@+id/geckoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#111420"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/pageProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100"
            android:progressTint="@color/wasp_yellow"
            android:progressBackgroundTint="#22000000"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Bee Panel: rodapé fixo, sempre visível quando mineração ativa -->
    <!-- Altura 56dp = minimizado (só status bar) -->
    <FrameLayout
        android:id="@+id/bee_panel_container"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#0B0B0D"
        android:visibility="gone" />

</LinearLayout>